{
  "info": {
    "_postman_id": "bitesync-restaurant-step3-autonomous-v1",
    "name": "BiteSync Restaurant API (Autonomous E2E - Step 3)",
    "description": "100% autonomous single-click Postman Collection Runner suite for Sprint 3A Step 3. Routes all traffic through API Gateway (localhost:8080). Generates unique runId per execution so it can be re-run infinitely without DB collisions. Verifies onboarding, JWT sub binding, RBAC, cross-owner isolation, embedded menu persistence, malformed ID guards, and ESR composite cursor pagination.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
