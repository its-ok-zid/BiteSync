              "const data = pm.response.json().data;",
              "pm.test('Returns 2nd distinct restaurant with hasNext=false', () => {",
              "    pm.expect(data.items).to.have.lengthOf(1);",
              "    pm.expect(data.items[0].id).to.not.eql(pm.collectionVariables.get('page1ItemId'));",
              "    pm.expect(data.hasNext).to.eql(false);",
              "    pm.expect(data.nextIdCursor).to.be.null;",
              "});"
            ]
          }
        }
