  "item": [
    {
      "name": "01. Setup - Login as Super Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@bitesync.com\",\n  \"password\": \"admin123\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('owner1Email', 'owner1.' + runId + '@bitesync.com');",
              "pm.collectionVariables.set('owner2Email', 'owner2.' + runId + '@bitesync.com');",
              "pm.collectionVariables.set('cityName', 'Bengaluru-' + runId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Admin accessToken captured', () => {",
              "    pm.expect(json.data.accessToken).to.be.a('string').and.not.be.empty;",
              "    pm.expect(json.data.role).to.include('ADMIN');",
              "});",
              "pm.collectionVariables.set('adminAccessToken', json.data.accessToken);"
            ]
          }
        }
      ]
    },
