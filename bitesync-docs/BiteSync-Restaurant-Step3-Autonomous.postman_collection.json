      "name": "25. Public Browse - Composite Cursor Pagination Page 1 (size=1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/restaurants?city={{cityName}}&size=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "restaurants"
          ],
          "query": [
            {
              "key": "city",
              "value": "{{cityName}}"
            },
            {
              "key": "size",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Returns 1 summary item with hasNext=true and composite cursors', () => {",
              "    pm.expect(data.items).to.have.lengthOf(1);",
              "    pm.expect(data.size).to.eql(1);",
              "    pm.expect(data.hasNext).to.eql(true);",
              "    pm.expect(data.nextRatingCursor).to.be.a('number');",
              "    pm.expect(data.nextIdCursor).to.be.a('string').and.not.be.empty;",
              "    pm.expect(data.items[0]).to.not.have.property('menuCategories');",
              "});",
              "pm.collectionVariables.set('page1ItemId', data.items[0].id);",
              "pm.collectionVariables.set('nextRatingCursor', data.nextRatingCursor.toString());",
              "pm.collectionVariables.set('nextIdCursor', data.nextIdCursor);"
            ]
          }
        }
      ]
    },
